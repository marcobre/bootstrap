# Colors: SilkCircuit Glow (https://github.com/hyperb1iss/silkcircuit, MIT),
# each role uses the color SilkCircuit's Neovim theme gives it
color-link default "#ffffff,#0a0816"
color-link comment "#cc66ff"

color-link identifier "#00ffff"
color-link identifier.class "#ffff00"
color-link identifier.var "#ffffff"

color-link constant "#ff66ff"
color-link constant.number "#ff66ff"
color-link constant.string "#ff99ff"

color-link symbol "#cc66ff"
color-link symbol.brackets "#ffffff"
color-link symbol.tag "#ff00ff"

color-link type "#ffff00"
color-link type.keyword "#d633ff"

color-link special "#ff66ff"
color-link statement "#d633ff"
color-link preproc "#ff66ff"

color-link underlined "#00d9ff"
color-link error "bold #ff2244"
color-link todo "bold #ff00ff"

color-link diff-added "#00ff00"
color-link diff-modified "#ffff00"
color-link diff-deleted "#ff2244"

color-link gutter-error "#ff2244"
color-link gutter-warning "#ffff00"

color-link statusline "#ffffff,#20003d"
color-link tabbar "#ffffff,#20003d"
color-link indent-char "#4b0654"
color-link line-number "#818181"
color-link current-line-number "#ffffff"

color-link cursor-line "#1a0033,#ffffff"
color-link color-column "#1a0033"
color-link type.extended "default"
