# Colors: Miami Wind (from the Omarchy theme by hanakin, MIT)
color-link default "#cdd6f4,#1e1e2e"
color-link comment "#585B70"

color-link identifier "#818cf8"
color-link identifier.class "#818cf8"
color-link identifier.var "#818cf8"

color-link constant "#fdba74"
color-link constant.number "#fdba74"
color-link constant.string "#34d399"

color-link symbol "#f472b6"
color-link symbol.brackets "#f472b6"
color-link symbol.tag "#818cf8"

color-link type "#818cf8"
color-link type.keyword "#fef08a"

color-link special "#f472b6"
color-link statement "#ec4899"
color-link preproc "#f472b6"

color-link underlined "#38bdf8"
color-link error "bold #f87171"
color-link todo "bold #fef08a"

color-link diff-added "#34d399"
color-link diff-modified "#fef08a"
color-link diff-deleted "#f87171"

color-link gutter-error "#f87171"
color-link gutter-warning "#fef08a"

color-link statusline "#CDD6F4,#181825"
color-link tabbar "#CDD6F4,#181825"
color-link indent-char "#45475A"
color-link line-number "#45475A"
color-link current-line-number "#818cf8"

color-link cursor-line "#252636,#cdd6f4"
color-link color-column "#252636"
color-link type.extended "default"