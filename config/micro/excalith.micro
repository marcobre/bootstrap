# Colors: Hackerman (Omarchy, MIT: https://github.com/omacom/omarchy/tree/dev/themes/hackerman),
# each role uses the color Hackerman's syntax table gives it
color-link default "#ddf7ff,#0b0c16"
color-link comment "#6a6e95"
color-link identifier "#7cf8f7"
color-link identifier.class "#50f7d4"
color-link identifier.var "#ddf7ff"
color-link constant "#50f7a3"
color-link constant.number "#50f7a3"
color-link constant.string "#4fe88f"
color-link symbol "#c4d2ed"
color-link symbol.brackets "#6a6e95"
color-link symbol.tag "#50f872"
color-link type "#50f7d4"
color-link type.keyword "#cddbf4"
color-link special "#cddbf4"
color-link statement "#cddbf4"
color-link preproc "#cddbf4"
color-link underlined "#829dd4"
color-link error "bold #50f872"
color-link todo "bold #82fb9c"
color-link diff-added "#4fe88f"
color-link diff-modified "#50f7d4"
color-link diff-deleted "#50f872"
color-link gutter-error "#50f872"
color-link gutter-warning "#50f7d4"
color-link statusline "#ddf7ff,#151828"
color-link tabbar "#ddf7ff,#151828"
color-link indent-char "#2d3450"
color-link line-number "#6a6e95"
color-link current-line-number "#ddf7ff"
color-link cursor-line "#10121f,#ddf7ff"
color-link color-column "#10121f"
color-link type.extended "default"
